# Database (local PostgreSQL on LXC)
DATABASE_URL="postgresql://combatcheck:yourpassword@localhost:5432/combatcheck"
DATABASE_SSL="false"

# Admin Dashboard
ADMIN_PASSWORD="your-secure-admin-password"

# Verification frequency in hours (24 = daily, 12 = twice daily, 168 = weekly)
VERIFICATION_INTERVAL_HOURS=24


# Telegram bot (see deploy/TELEGRAM_SETUP.md)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: cron timezone (default Asia/Jerusalem)
CRON_TIMEZONE="Asia/Jerusalem"
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEET_GID=""